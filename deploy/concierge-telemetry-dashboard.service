[Unit]
Description=Concierge Telemetry Dashboard
After=network.target mariadb.service

[Service]
User=telemetry
Group=telemetry
WorkingDirectory=/opt/telemetry/concierge-telemetry-dashboard
EnvironmentFile=/etc/concierge-telemetry-dashboard/dashboard.env
ExecStart=/opt/telemetry/dashboard-venv/bin/gunicorn dashboard.wsgi:application --bind 127.0.0.1:8081 --workers 2 --threads 4 --timeout 30 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
